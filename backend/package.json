{
  "name": "kontrol-audit",
  "version": "1.0.0",
  "description": "KONTROL - Dockerfile security & configuration audit. CLI with JSON/Markdown/SARIF output and policy gates, plus an Express API.",
  "main": "server.js",
  "bin": {
    "kontrol": "cli.js"
  },
  "files": [
    "server.js",
    "cli.js",
    "lib/",
    "rules.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Mayur Bagade",
  "homepage": "https://github.com/mayurbagade456/kontrol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayurbagade456/kontrol.git",
    "directory": "backend"
  },
  "bugs": {
    "url": "https://github.com/mayurbagade456/kontrol/issues"
  },
  "engines": {
    "node": ">=18.0.0 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch server.js --watch lib --watch rules.json server.js",
    "scan": "node cli.js",
    "check": "node -e \"require('./lib/engine').loadRules(require('path').join(__dirname, 'rules.json')); console.log('rules.json OK')\""
  },
  "keywords": [
    "docker",
    "dockerfile",
    "security",
    "audit",
    "linter",
    "devsecops",
    "sarif",
    "cli",
    "express"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
