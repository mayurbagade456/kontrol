# Base URL of the KONTROL API. Leave empty to use the Vite dev proxy (/api -> VITE_API_PROXY_TARGET).
VITE_API_URL=

# Backend target used by the Vite dev-server proxy
VITE_API_PROXY_TARGET=http://localhost:4000

# Public repository link shown in the header
VITE_GITHUB_URL=https://github.com/mayurbagade456/kontrol
